{
  "appId": "com.tidtam.app",
  "appName": "TidTam",
  "webDir": "build",
  "server": {
    "url": "https://da-app.vercel.app",
    "androidScheme": "https",
    "errorPath": "app-offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#182031",
    "scheme": "TidTam",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#182031",
      "overlaysWebView": false
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
