# ── da-app (หน้าจอ) ──────────────────────────────────────────────────────────
# คัดลอกเป็น .env แล้วแก้ให้ตรงกับองค์กรของคุณ (Vite อ่านเฉพาะตัวแปรที่ขึ้นต้น REACT_APP_)
REACT_APP_API_URL=http://localhost:5000/api

# ── ชื่อองค์กรที่ใช้ "ตอนยังต่อเซิร์ฟเวอร์ไม่ได้" (หน้าเข้าสู่ระบบ/โหมดออฟไลน์) ──
# ค่าจริงมาจาก GET /api/settings เสมอ — ตรงนี้เป็นแค่ค่าสำรอง
REACT_APP_ORG_NAME_TH=องค์กรของคุณ
REACT_APP_ORG_NAME_EN=YOUR ORGANIZATION
REACT_APP_ORG_ADDRESS=
REACT_APP_ORG_TAX_ID=

# ลิงก์เว็บไซต์บริษัท (da-web) — ใช้ทำปุ่ม "ดูบนเว็บไซต์" ในหน้าหลังบ้านเว็บไซต์ (ว่าง = ไม่แสดงปุ่ม)
# ⚠️ URL เต็ม ไม่มี / ปิดท้าย
REACT_APP_WEBSITE_URL=
